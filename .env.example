# Copy to .env and set a valid OpenAI project key. Never put it in browser code.
OPENAI_API_KEY=
PORT=4317

# Default: use your ChatGPT-authenticated Codex CLI for all backend reasoning.
# Set to api only if you explicitly want paid gpt-5.6-terra API reasoning.
REASONING_BACKEND=codex
# Optional absolute path if codex is not on the app server's PATH.
# CODEX_BIN=/opt/homebrew/bin/codex
