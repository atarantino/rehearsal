// Installed only in an isolated .agent project. These functions are admin-only.
import { internalQuery, internalMutation } from "./_generated/server";
import { v } from "convex/values";
export const inspect = internalQuery({
  args: {},
  returns: v.object({
    users: v.array(v.object({ id: v.id("users"), username: v.union(v.string(), v.null()) })),
    sessions: v.array(v.object({ id: v.id("sessions"), ownerId: v.id("users"), status: v.string(), feedbackState: v.string() })),
    opportunities: v.array(v.object({ id: v.id("opportunities"), ownerId: v.id("users"), status: v.string(), workflowId: v.optional(v.string()) })),
  }),
  handler: async ctx => ({
    users: (await ctx.db.query("users").order("desc").take(100)).map(u => ({ id: u._id, username: u.username })),
    sessions: (await ctx.db.query("sessions").order("desc").take(100)).map(s => ({ id: s._id, ownerId: s.ownerId, status: s.record.status, feedbackState: s.feedbackState })),
    opportunities: (await ctx.db.query("opportunities").order("desc").take(100)).map(o => ({ id: o._id, ownerId: o.ownerId, status: o.status, workflowId: o.workflowId })),
  }),
});
export const scenario = internalMutation({
  args: { id: v.id("sessions"), scenario: v.union(v.literal("feedback-failure"), v.literal("feedback-recover"), v.literal("stale-feedback")) },
  returns: v.null(),
  handler: async (ctx, { id, scenario }) => {
    const s = await ctx.db.get(id);
    if (!s) throw new Error("Choose a session from agent:inspect.");
    if (scenario === "stale-feedback") {
      if (s.record.status === "active" || s.record.status === "connecting") throw new Error("End the session first.");
      await ctx.db.patch(id, { feedbackState: "running", feedbackStartedAt: Date.now() - 600000, record: { ...s.record, feedback: undefined } });
    } else {
      await ctx.db.patch(id, { record: { ...s.record, config: { ...s.record.config, background: scenario === "feedback-failure" ? "QA_FAIL_FEEDBACK" : "" } } });
    }
    return null;
  },
});
